# ============================================
# MaiinSight Frontend - Environment Variables
# ============================================
# Copy this file to .env and fill in values.

# Backend API base URL (no trailing slash)
# Dev:     http://localhost:5000
# Production: inject the actual public backend URL through the deployment platform.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
# Backward-compatible legacy name (optional; BASE_URL takes priority when both exist):
# NEXT_PUBLIC_API_URL=http://localhost:5000

# Google OAuth web client ID. Must match backend GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
